<?xml version="1.0"?>
<ruleset name="joinchat">
	<description>joinchat</description>

	<file>.</file>

	<arg name="extensions" value="php"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.9"/>

	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Docs" />
	<rule ref="WordPress-Extra" />

	<rule ref="PHPCompatibilityWP" />

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="creame-whatsapp-me" />
		</properties>
	</rule>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/gutenberg/build/*</exclude-pattern>
	<exclude-pattern>*/languages/*.l10n.php</exclude-pattern>
</ruleset>
